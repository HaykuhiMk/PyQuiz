# Local MongoDB data directory (used by backend/scripts/start-mongo.sh)
.mongo-data/

# OS metadata
.DS_Store

# Scratch files for one-off scripts/verification during a task — never committed
/tmp/

# Playwright smoke suite artifacts
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/

# Environment files hold real secrets: ignore every .env and .env.* in any
# folder. Only the placeholder example files are committed.
.env
.env.*
!backend/env.example
!frontend/.env.example
