EMAIL_USER=
EMAIL_PASS=
JWT_SECRET=

# Server secret used to derive the Daily Challenge seed (HMAC-SHA256 with
# the challenge date). Required to serve/score the Daily Challenge; not
# needed for anything else. Keep it secret — anyone who has it (and knows
# the date) could predict that day's question set in advance.
DAILY_CHALLENGE_SEED_SECRET=
MONGO_URI=mongodb://127.0.0.1:27017/pyquiz

# Number of reverse-proxy hops in front of this server (e.g. nginx or a
# platform load balancer terminating TLS), so Express's req.ip — and every
# IP-keyed rate limiter — resolves the real client address from
# X-Forwarded-For instead of the proxy's own address. Leave unset with no
# reverse proxy in front (Express then trusts nothing, its safe default).
#   "1" - exactly one hop (the common case) - set this to the EXACT number
#         of reverse-proxy hops in front of the app.
#   unset/"false" - trust none (default)
#
# NEVER set this to "true". "true" trusts every hop in X-Forwarded-For,
# including a value the client itself sent, which lets any client spoof
# req.ip and bypass every IP-keyed rate limiter in this app outright -
# including login/register brute-force protection. It is only technically
# supported because Express itself accepts it; this app logs a startup
# warning if you set it anyway.
TRUST_PROXY=
PORT=
CLIENT_URI=
API_URI=
REDIS_URL=
LOG_LEVEL=info